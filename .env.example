##############################################
# ORAN target runtime: Vercel + Supabase
##############################################

# Copy to `.env.local`. Never commit real secrets.

# Supabase Postgres
# Runtime: use the transaction pooler (port 6543) with TLS on Vercel.
# node-postgres must use libpq-compatible `require` semantics with Supavisor:
# the connection is TLS-encrypted without requiring a locally installed CA.
DATABASE_URL=postgres://oran_backend_runtime.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?uselibpqcompat=true&sslmode=require
DATABASE_POOL_MAX=2
# Fixed dedicated database identity required by the ORAN server connection.
# The application rejects a production URL authenticated as any other role.
ORAN_DATABASE_ROLE=oran_backend_runtime
# Non-secret project identity guard. The runtime rejects a pooled URL for any
# other Supabase project.
ORAN_SUPABASE_PROJECT_REF=<project-ref>

# Migration/backup jobs: store the direct Supabase connection as the
# SUPABASE_DB_URL GitHub Environment secret. Do not expose it to the browser.
SUPABASE_DB_URL=

# Reserved for browser/server Data API access after the RLS audit is complete.
# Use a publishable key only; never expose a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only seeker publication brake. Omit or use positive_authority for the
# normal affirmative provenance gate. Set deny_all to remove every resource
# from public discovery during an incident. Unknown values also deny all.
ORAN_PUBLICATION_SAFETY_MODE=positive_authority

# Clerk identity
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_SIGN_IN_URL=/auth/signin
CLERK_SIGN_UP_URL=/auth/signup

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Build-time source-map upload only. Configure as a Vercel secret.
SENTRY_AUTH_TOKEN=

RESEND_API_KEY=
RESEND_FROM=

# Optional ORAN-dedicated cache accelerator. Production shared rate limiting is
# authoritative in the atomic Supabase/Postgres function so provider failover
# cannot reset a caller's counter. Database-less local/test runtimes may use
# Redis or bounded process memory.
REDIS_URL=

# 211 polling (optional)
NDP_211_POLLING_ENABLED=false
NDP_211_SUBSCRIPTION_KEY=
NDP_211_DATA_OWNERS=

# Required in Vercel Production. Vercel sends this value automatically as a
# Bearer token to registered cron routes. Generate a dedicated random value of
# at least 32 characters; never prefix it with NEXT_PUBLIC_.
CRON_SECRET=

# Optional rollback-only credential for authenticated worker-to-app calls.
# Send it in x-oran-internal-key; do not reuse CRON_SECRET.
INTERNAL_API_KEY=
