##############################################
# ORAN target runtime: Vercel + Supabase
##############################################

# Copy to `.env.local`. Never commit real secrets.

# Supabase Postgres
# Runtime: use the transaction pooler (port 6543) with TLS on Vercel.
DATABASE_URL=postgres://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_POOL_MAX=2

# Migration/backup jobs: store the direct Supabase connection as the
# SUPABASE_DB_URL GitHub Environment secret. Do not expose it to the browser.
SUPABASE_DB_URL=

# Reserved for browser/server Data API access after the RLS audit is complete.
# Use a publishable key only; never expose a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clerk target identity (auth cutover phase)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_SIGN_IN_URL=/auth/signin
CLERK_SIGN_UP_URL=/auth/signup

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Build-time source-map upload only. Configure as a Vercel secret.
SENTRY_AUTH_TOKEN=

# Direct OpenAI API (optional; retrieval and deterministic safety still work without it)
OPENAI_API_KEY=

# Provider-neutral shared cache/rate limiting (optional during the first cutover)
REDIS_URL=

# 211 polling (optional)
NDP_211_POLLING_ENABLED=false
NDP_211_SUBSCRIPTION_KEY=
NDP_211_DATA_OWNERS=

##############################################
# Temporary auth bridge — remove after Clerk cutover
##############################################

# The current release still uses NextAuth while the Clerk middleware, UI, role
# provisioning, and account-linking flow move as one fail-closed change.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Legacy providers are optional and must not be configured on the target Vercel
# project unless a rollback release explicitly requires them.
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Temporary shared secret for any remaining legacy worker-to-app calls.
INTERNAL_API_KEY=
