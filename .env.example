##############################################
# ORAN Environment Variables
##############################################
#
# Local development:
# - Copy this file to `.env.local` and fill in values.
# - Never commit real secrets.
#
# ORAN targets the Automated Empires portfolio stack (Supabase Postgres, Vercel,
# Resend, Sentry, PostHog, OpenAI, tokenless OpenStreetMap). Every external
# integration below is OPTIONAL and fails open — the app runs locally with only
# DATABASE_URL. See docs/CONVERGENCE.md for the migration state and the remaining
# authenticated activation controls (Clerk, Supabase, and Vercel).

# Canonical public origin. Set this explicitly in every deployed lane so metadata,
# sitemap URLs, and JSON-LD do not silently point at another environment.
NEXT_PUBLIC_SITE_URL=https://openresourceaccessnetwork.com

# ── Database (Supabase Postgres + PostGIS + pgvector) ───────
# Local Docker Compose (see db/docker-compose.yml) uses sslmode=disable.
# Production: Supabase project "oran" (ref tpatxospkuqvajusuryw, us-east-1).
# A populated schema exists, but its remote ledger does not prove the 53-file
# repository history. Do not run migrations until the baseline gate is complete:
# docs/ops/core/DATABASE_MIGRATION_BASELINE.md.
# Set DATABASE_URL to the project's connection string from the Supabase dashboard
# (Settings -> Database -> Connection string -> Transaction pooler), e.g.:
#   postgresql://postgres.tpatxospkuqvajusuryw:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# TLS is auto-configured by src/db/ssl.ts. Install the connection string through
# authenticated provider access; never copy it into source or documentation.
DATABASE_URL=postgres://oran:oran_local_password@localhost:5432/oran_db?sslmode=disable

# ── Authentication (Clerk) ──────────────────────────────────
# ORAN uses Clerk for identity (create a Clerk application, then paste the keys).
# Roles + account status are DB-driven (user_profiles.role / organization_members);
# Clerk provides identity only. OAuth providers (Google, Microsoft, Apple, …) are
# configured in the Clerk dashboard, not here. When these keys are unset,
# protected routes fail closed in production and are open in local dev.
# Clerk app creation/configuration requires authenticated provider access.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk mounts its sign-in/up UI at these routes (ORAN's branded chooser is /auth/signin).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/chat
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/chat

# ── AI (OpenAI) — optional post-retrieval summarization only ─
# ORAN never lets an LLM retrieve, rank, or invent facts (see docs/CHAT_ARCHITECTURE.md).
# OPENAI_API_KEY is the portfolio default. OPENAI_BASE_URL overrides the endpoint
# (e.g. a gateway). OPENAI_CHAT_MODEL defaults to gpt-4o-mini.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Legacy Azure OpenAI fallback (still supported; prefer OPENAI_API_KEY):
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-07-01-preview

# ── Email (Resend) ──────────────────────────────────────────
# API key from the Resend dashboard. RESEND_FROM must be a verified sender.
# When unset, transactional email is skipped (fail-open).
RESEND_API_KEY=
RESEND_FROM=ORAN <notifications@oran.example>

# ── Error monitoring (Sentry) ───────────────────────────────
# Optional, code-ready. Set the DSN to enable server + client error reporting
# (install @sentry/nextjs to activate). Product analytics uses PostHog.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# ── Product analytics (PostHog) — optional, client-side ─────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Maps & Geocoding (tokenless OpenStreetMap) ──────────────
# The interactive map uses OpenStreetMap tiles (react-leaflet) — no key needed.
# Geocoding uses the public OSM Nominatim service. For high-volume ingestion,
# point NOMINATIM_BASE_URL at a self-hosted instance and set a contact UA.
NOMINATIM_BASE_URL=
GEOCODER_USER_AGENT=

# ── Cache / rate limiting (Redis) — optional ────────────────
# Any Redis-compatible URL (e.g. Upstash). Falls back to in-memory when unset.
# Format: rediss://:password@hostname:6380 (TLS)
REDIS_URL=

# ── Internal service auth ───────────────────────────────────
# Shared secret for worker → app internal calls. Generate: openssl rand -base64 32
INTERNAL_API_KEY=
# Vercel uses this bearer secret to authenticate scheduled cron requests.
CRON_SECRET=

# ── 211 / National Data Platform feed (optional ingestion) ──
NDP_211_POLLING_ENABLED=false
NDP_211_SUBSCRIPTION_KEY=
NDP_211_DATA_OWNERS=

# ── Legacy Azure integrations (optional; slated for removal) ─
# See docs/CONVERGENCE.md. Translation and TTS fail open when unset.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_ENDPOINT=
AZURE_TRANSLATOR_REGION=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
